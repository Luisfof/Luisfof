# Copie para .env e ajuste. Nunca versione o .env.
PORT=8787
NODE_ENV=development
# Caminho do banco SQLite e das imagens enviadas
DATA_DIR=./data
# Conta administrativa criada na primeira execução (obrigatório em produção)
ADMIN_EMAIL=admin@moraago.local
ADMIN_PASSWORD=troque-esta-senha-longa
# Popular o banco com anúncios DEMONSTRATIVOS claramente identificados (true/false)
SEED_DEMO=true
# URL pública (usada em metadados/compartilhamento). Ex.: https://moraago.com.br
PUBLIC_URL=http://localhost:8787
# Defina true quando estiver atrás de proxy HTTPS (Render, Fly, Cloudflare Tunnel...)
TRUST_PROXY=false
